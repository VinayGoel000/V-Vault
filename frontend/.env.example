# Development proxy target for /api requests. The backend is local-only.
VITE_BACKEND_URL=http://127.0.0.1:3765

# Optional API base. If omitted in a production build, the typed client uses
# http://127.0.0.1:3765. In development, same-origin /api is proxied to the
# same local backend to avoid requiring CORS.
# VITE_API_URL=http://127.0.0.1:3765
